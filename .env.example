# Telegram
PROFITPILOT_TELEGRAM_TOKEN=
PROFITPILOT_TELEGRAM_CHAT_ID=

# Runner
PROFITPILOT_INTERVAL_SECONDS=900
PROFITPILOT_STATE_FILE=data/alert_state.json

# Optional: explicitly allow runner startup without Amazon Creators API
# Note: eBay-only mode produces no cross-market deals until an Amazon buy source is configured.
PROFITPILOT_EBAY_ONLY=0
